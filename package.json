{
  "name": "frontpage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "check:repositories": "node scripts/check-repository-coverage.mjs",
    "pretest:e2e": "node tests/e2e/prepare-runtime.mjs",
    "test:e2e": "playwright test",
    "build:cloudflare": "opennextjs-cloudflare build && cp cloudflare/do-entry.mjs .open-next/do-entry.mjs",
    "deploy:cloudflare": "wrangler deploy --config wrangler.jsonc",
    "test:cloudflare": "node --test --test-concurrency=1 tests/cloudflare/runtime.test.mjs",
    "build:owner-tool": "node scripts/build-owner-state-tool.mjs"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "brace-expansion": "^5.0.9",
    "lucide-react": "^1.24.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "uplot": "1.6.32",
    "zod": "^4.4.3",
    "jose": "6.2.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.142.0",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
