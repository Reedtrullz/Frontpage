[Unit]
Description=Upload Frontpage public metrics snapshots to Cloudflare
Wants=network-online.target
After=network-online.target frontpage-metrics-collector.service

[Service]
Type=oneshot
User=frontpage-metrics
Group=frontpage-metrics
Environment=FRONTPAGE_METRICS_DIR=/var/lib/frontpage-metrics/v1
Environment=FRONTPAGE_UPLOAD_URL=https://frontpage.reidjoss.workers.dev
Environment=FRONTPAGE_UPLOAD_SECRET_FILE=/etc/frontpage-metrics/cloudflare-upload-secret
ExecStart=/usr/local/bin/frontpage-metrics-upload
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/frontpage-metrics/v1 /etc/frontpage-metrics
